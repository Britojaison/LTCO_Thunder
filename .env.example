# Site address used in invite / registration / sign-in links.
# Local: leave unset (http://localhost:3000). On Vercel it defaults to the production domain;
# set it once you have a custom domain, e.g. https://thunder.88gb.in
# NEXT_PUBLIC_SITE_URL=

